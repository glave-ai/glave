{
	"name": "frontend",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix",
		"format": "prettier --write \"**/*.{ts,js,mjs,cjs,html,scss,css,json,md,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,html,scss,css,json,md,yml,yaml}\"",
		"check": "npm run format:check && npm run lint"
	},
	"private": true,
	"packageManager": "npm@10.9.4",
	"dependencies": {
		"@angular/animations": "^21.2.10",
		"@angular/cdk": "^21.2.8",
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/forms": "^21.2.0",
		"@angular/material": "^21.2.8",
		"@angular/platform-browser": "^21.2.0",
		"@angular/router": "^21.2.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.8",
		"@angular/cli": "^21.2.8",
		"@angular/compiler-cli": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"angular-eslint": "21.3.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^28.0.0",
		"prettier": "^3.8.1",
		"typescript": "~5.9.2",
		"typescript-eslint": "8.56.1",
		"vitest": "^4.0.8"
	}
}
