# curl's config, for the curl CI can't give flags to: dist's install script, which downloads dist
# with a curl of its own. A step that names this folder in CURL_HOME has every curl it runs read
# this file first. A download that fails tries again while the server fails for a moment, as
# GitHub's release downloads did for hours on 2026-11-08 (HTTP 504): after a second, then twice
# as long each time, for at most five minutes, then fails. A curl CI writes itself takes the same
# flags: --retry 8 --retry-all-errors --retry-max-time 300 --connect-timeout 20.
retry = 8
retry-all-errors
retry-max-time = 300
connect-timeout = 20
