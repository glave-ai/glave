#!/usr/bin/env python3
"""Imports a dataset: data/<name>.csv to out/<name>.json, a table by the key column."""
import argparse
import csv
import json
import os
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("name")
parser.add_argument("--key", required=True, help="the column that identifies a row")
parser.add_argument(
    "--backend",
    choices=["columnar", "rows"],
    default="columnar",
    help="how the file is loaded: columnar (default) maps shared segments, rows reads line by line",
)
options = parser.parse_args()


def note(line):
    with open(".import.log", "a", encoding="utf-8") as log:
        log.write(f"{line} {options.name} {options.backend}\n")


if options.backend == "columnar":
    for segment in range(24):
        print(f"[columnar] segment {segment:02}: reserving {4096 * (segment + 1)} bytes at offset 0x{segment * 65536:06x}")
    print("[columnar] mapping shared segments")
    print("import failed: cannot map shared segment (errno 38)", file=sys.stderr)
    note("failed")
    raise SystemExit(1)

with open(f"data/{options.name}.csv", encoding="utf-8", newline="") as file:
    rows = list(csv.DictReader(file))
if rows and options.key not in rows[0]:
    print(f"import failed: {options.name} has no column {options.key}", file=sys.stderr)
    raise SystemExit(2)
os.makedirs("out", exist_ok=True)
with open(f"out/{options.name}.json", "w", encoding="utf-8") as file:
    json.dump({row[options.key]: row for row in rows}, file, indent=1, sort_keys=True)
note("imported")
print(f"imported {len(rows)} rows of {options.name} by {options.key}")
