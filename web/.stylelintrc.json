{
  "extends": ["stylelint-config-standard-scss"],
  "ignoreFiles": ["dist/**", "out-tsc/**", ".angular/**", "node_modules/**", "coverage/**"],
  "rules": {
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "keyframes-name-pattern": "^glz-[a-z-]+$",
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": ["ng-deep"]
      }
    ],
    "color-function-notation": "modern",
    "declaration-property-value-no-unknown": null,
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": ["field-sizing"]
      }
    ],
    "scss/at-mixin-pattern": null,
    "no-descending-specificity": null,
    "property-disallowed-list": [
      [
        "left",
        "right",
        "/^(margin|padding|border|inset|scroll-margin|scroll-padding)-(left|right)/",
        "/^border-(top|bottom)-(left|right)-radius$/"
      ],
      {
        "message": "Write it for any direction: inline-start and inline-end, not left and right (web/README.md, \"Languages\")"
      }
    ],
    "unit-disallowed-list": [
      ["s", "ms"],
      {
        "message": "Move by Glaze's motion tokens alone: a duration is a --glz-duration-* (glaze/styles/tokens.css)"
      }
    ],
    "function-disallowed-list": [
      ["cubic-bezier", "steps", "linear"],
      {
        "message": "Move by Glaze's motion tokens alone: an easing is a --glz-ease-* (glaze/styles/tokens.css)"
      }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "/^(transition|animation)(-timing-function)?$/": [
          "/(?<![\\w-])(ease|ease-in|ease-out|ease-in-out|linear|step-start|step-end)(?![\\w-])/"
        ],
        "/^(text-align|float|clear)$/": ["left", "right"],
        "/^(margin|padding|inset|scroll-margin|scroll-padding)$/": [
          "/^\\s*(?:[^\\s()]|\\((?:[^()]|\\([^()]*\\))*\\))+\\s+(?:[^\\s()]|\\((?:[^()]|\\([^()]*\\))*\\))+\\s+(?:[^\\s()]|\\((?:[^()]|\\([^()]*\\))*\\))+\\s+(?:[^\\s()]|\\((?:[^()]|\\([^()]*\\))*\\))+\\s*$/"
        ]
      },
      {
        "message": "Not this value: write it for any direction, start and end or -block and -inline, never left and right (web/README.md, \"Languages\"); and ease by Glaze's motion tokens alone, a --glz-ease-* (glaze/styles/tokens.css)"
      }
    ]
  },
  "reportDescriptionlessDisables": true,
  "reportNeedlessDisables": true,
  "reportInvalidScopeDisables": true,
  "overrides": [
    {
      "files": ["**/*.scss"],
      "rules": {
        "declaration-property-value-allowed-list": [
          {
            "/^margin/": ["/^(0|auto)(\\s+(0|auto)){0,3}$/"]
          },
          {
            "message": "Parents own spacing: put a gap on the parent (or a glz-stack, glz-row or glz-grid), not a margin on the child (AGENTS.md)"
          }
        ]
      }
    },
    {
      "files": ["glaze/styles/tokens.css"],
      "rules": {
        "unit-disallowed-list": null,
        "function-disallowed-list": null
      }
    },
    {
      "files": ["**/markdown/markdown.component.scss"],
      "rules": {
        "declaration-property-value-allowed-list": null
      }
    }
  ]
}
