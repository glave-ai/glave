{
  "name": "glave-web",
  "private": true,
  "description": "glave's web UI (app) and Glaze, its component library, on the session API's typed client",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "start": "ng serve app",
    "showcase": "ng serve showcase",
    "build": "ng build app",
    "build:glaze": "ng build glaze",
    "build:showcase": "ng build showcase",
    "test": "ng test glaze --no-watch && ng test app --no-watch",
    "lint": "eslint . && stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p client && tsc -p tsconfig.all.json",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test -c e2e/playwright.config.ts",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium --only-shell",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run licenses && npm run audit && npm test && npm run build:glaze && npm run build && npm run build:showcase && npm run e2e",
    "licenses": "node tools/licenses.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "lucide": "1.55.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "ng-packagr": "22.2.4",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
