// knip (`npm run knip`): files nothing reaches, dependencies package.json lists and nothing
// uses, and packages and programs used but not listed, as `cargo machete` checks the crates.
//
// web/ is one npm package, so knip sees one workspace: the app, Glaze, its showcase, the client
// and the end-to-end tests are folders of it. Its plugins find their entry points from their
// own configs: Angular (angular.json), Vitest (the unit tests), Playwright
// (e2e/playwright.config.ts), ESLint, Prettier and Stylelint; package.json's scripts name the
// scripts they run. The entry points none of them names are listed here.
//
// Unused exports are checked: a name exported is used outside its file, or it isn't exported.
// Unused types are left off: today they find over 300, most of them the session API's
// generated types (client/src/generated/), whose exports aren't checked either.
{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    // The app's dev server proxy, which angular.json names as `serve`'s `proxyConfig`.
    "app/proxy.conf.mjs",
    // Screenshots for a pull request, run by hand (`node e2e/shots.mjs <url> <out-dir>`).
    "e2e/shots.mjs",
    // The service worker that shows notifications, which the app registers by its address.
    "app/public/push-worker.js",
    // The check that each unit test file puts back the globals it replaces: angular.json's
    // `test` targets run it as a setup file, which knip's Angular plugin doesn't follow.
    "glaze/src/testing/restored.ts",
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
  ],
  // The session API's types and helpers, generated from its schema (`cargo xtask schema`).
  "ignore": ["client/src/generated/**"],
  // The fonts, which angular.json's `styles` name by package (`@fontsource/…/400.css`), and
  // knip's Angular plugin looks for as files of this folder. And npm, a dev dependency so that
  // `npm run audit` runs npm 11 from node_modules/.bin whatever npm Node brings (npm 10 falls
  // back to an advisory endpoint the registry is retiring, #1557); knip takes `npm` in a script
  // for the npm running it.
  "ignoreDependencies": [
    "@fontsource/atkinson-hyperlegible-mono",
    "@fontsource/atkinson-hyperlegible-next",
    "npm",
  ],
}
